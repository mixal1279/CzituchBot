# Skopiuj do .env i uzupełnij tylko integracje, których używasz.
# Nie wpisuj prawdziwych sekretów do repozytorium.

# Google / YouTube
GOOGLE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_API_KEY=

# AI: Groq, OpenRouter, xKiro, Tavily, Exa
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_VALIDATOR_MODEL=
OPENROUTER_GENERATOR_MODEL=
XKIRO_API_KEY=
XKIRO_BASE_URL=https://api.xkiro.com/v1
XKIRO_MODEL=qwen/qwen3.5-397b-a17b:free
TAVILY_API_KEY=
EXA_API_KEY=

# Modele AI (wartości domyślne są ustawione w kodzie)
AI_QUERY_REWRITE_MODEL=openai/gpt-oss-20b
AI_VALIDATOR_MODEL=openai/gpt-oss-20b
AI_WEB_SEARCH_MODEL=gemini-3.8-flash
AI_GENERATOR_MODEL=openai/gpt-oss-120b
AI_GEMINI_MODEL=gemini-3.8-flash
AI_GEMINI_LITE_MODEL=gemini-3.5-flash-lite
AI_GEMINI_VALIDATOR_MODEL=gemini-3.5-flash-lite
AI_VALIDATOR_GROQ=
AI_GROQ_VALIDATOR_MAX_EVIDENCE_CHARS=
AI_XKIRO_VALIDATOR_TIMEOUT_MS=3000
AI_PROVIDER_QUOTA_COOLDOWN_MS=
AI_MAX_FALLBACK_STEPS=6
AI_120B_GLOBAL_MAX_REQUESTS=
AI_CACHE_DIR=
AI_TAVILY_CACHE_FILE=
TAVILY_MIN_SCORE=
AI_ALLOW_PARTIAL_ANSWERS=0
AI_GEMINI_EXTRACT=0
AI_QUALITY_ALL_PROFILES=0

# Twitch
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_OAUTH_TOKEN_BROADCASTER_BILLY=
TWITCH_OAUTH_TOKEN_EDLOR=
TWITCH_REFRESH_TOKEN_EDLOR=
TWITCH_REWARD_ID_ZADANIE=
TWITCH_REWARD_ID_ZADANIE_KROTKIE=
TWITCH_REWARD_ID_ZADANIE_DLUGIE=
TRELLO_LIST_ID_ZADANIE_KROTKIE=
TRELLO_LIST_ID_ZADANIE_DLUGIE=

# Kick OAuth / Cloudflare Worker
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_WORKER_URL=
KICK_WORKER_SECRET=

# Inne integracje
ITAD_API_KEY=
API_NINJAS_KEY=
NOTION_TOKEN=
POLISHSTEAMDB_BOT_TOKEN=
KICK_ALERT_CHANNEL_ID=
KICK_ALERT_USER_ID=

# Opcjonalne parametry uruchomieniowe / diagnostyczne
NODE_ENV=production
CZITUCHBOT_SKIP_STARTUP_IO=0
AI_BENCHMARK_SEED=0
AI_BENCHMARK_LIMIT=5
AI_BENCHMARK_DELAY_MS=5000
AI_BENCHMARK_REQUIRE_PERFECT=1
AI_LIVE_BENCHMARK=0
PREFLIGHT_TIMEOUT_MS=20000
PREFLIGHT_STRICT=0

# Nie ustawiaj sekretów CI tutaj. W GitHub Actions skonfiguruj osobne Secrets:
# GROQ_API_KEY_CI, TAVILY_API_KEY, GEMINI_API_KEY, EXA_API_KEY,
# XKIRO_API_KEY, OPENROUTER_API_KEY.
